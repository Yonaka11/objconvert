<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base theme used by the manifest. Activity content is fully drawn by Compose,
        so this only sets the window background and status bar behavior.
    -->
    <style name="Theme.PocketFamiliar" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
