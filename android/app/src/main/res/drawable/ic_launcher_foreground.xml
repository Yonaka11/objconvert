    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ghost body centered in safe zone -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,24
            C43.5,24 35,32.5 35,43
            L35,70
            Q39.75,63 44.5,70
            Q49.25,63 54,70
            Q58.75,63 63.5,70
            Q68.25,63 73,70
            L73,43
            C73,32.5 64.5,24 54,24 Z" />

    <!-- Left eye sclera (ellipse cx=46 cy=46 rx=4 ry=5) -->
