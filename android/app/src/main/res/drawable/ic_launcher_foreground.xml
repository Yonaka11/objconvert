        android:fillColor="#A78BFA"
        android:pathData="M42,46 a4,5 0 1,0 8,0 a4,5 0 1,0 -8,0 Z" />

    <!-- Right eye sclera (ellipse cx=62 cy=46 rx=4 ry=5) -->
    <path
        android:fillColor="#A78BFA"
        android:pathData="M58,46 a4,5 0 1,0 8,0 a4,5 0 1,0 -8,0 Z" />

    <!-- Left pupil (circle cx=47 cy=47 r=2) -->
